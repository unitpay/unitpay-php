<?xml version="1.0"?>
<ruleset name="unitpay-php-sdk"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Curated PHPMD ruleset for the single-file, global-namespace Unitpay SDK.
        A few default rules are excluded or retuned because they conflict with the
        SDK's deliberate design rather than pointing at real problems.
    </description>

    <rule ref="rulesets/cleancode.xml">
        <!-- The value object legitimately references its own class constants via self:: -->
        <exclude name="StaticAccess"/>
        <!-- Global-namespace SDK by design: there is nothing to import -->
        <exclude name="MissingImport"/>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <!-- CashItem is long solely because of the 54-FZ enum-style constant dictionaries -->
        <exclude name="ExcessiveClassLength"/>
        <exclude name="TooManyPublicMethods"/>
        <exclude name="TooManyMethods"/>
        <!-- Retuned below rather than dropped, so genuinely complex future code still trips -->
        <exclude name="CyclomaticComplexity"/>
        <exclude name="NPathComplexity"/>
        <exclude name="ExcessiveClassComplexity"/>
    </rule>

    <!--
        UnitPay deliberately holds four responsibilities in one class (outbound
        signing, API calls, webhook verification, handler responses), so its WMC
        (sum of per-method complexities) grows with every API method and feature —
        each of which is individually simple. Lift the class-complexity threshold
        modestly rather than dropping the rule, so a genuinely tangled method
        still trips it.
    -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="60"/>
        </properties>
    </rule>

    <!--
        checkHandlerRequest() is a flat chain of security guard clauses (CC 10);
        allow one more before flagging.
    -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="11"/>
        </properties>
    </rule>

    <!--
        setCashItems() and checkHandlerRequest() reach NPath 256 because of the
        eight independent "serialize optional field when set" blocks / guard
        clauses — linear, not tangled. Lift the threshold modestly.
    -->
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="300"/>
        </properties>
    </rule>

    <rule ref="rulesets/controversial.xml">
        <!-- Reading $_GET/$_SERVER is the documented webhook-verification design -->
        <exclude name="Superglobals"/>
    </rule>

    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <!-- The SDK favours descriptive names; $ip is idiomatic, the long
             $supportedUnitpayMethods et al. are intentional. -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>

    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
